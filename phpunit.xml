<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="ledger">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- The suite drives the running service over HTTP. Overridable so it
             can be pointed at a container from the host, or the reverse. -->
        <env name="LEDGER_BASE_URL" value="http://localhost:8080"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
